meta {
  name: Find Stale Interceptor for Cleanup
  type: http
  seq: 1
}

get {
  url: {{env_url}}/api/v1/interceptors
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body.interceptors) {
    var stale = res.body.interceptors.find(function(i) {
      return i.trigger_point === "POST_USER_AUTHENTICATION";
    });
    bru.setEnvVar("test_stale_interceptorid", stale ? stale.id : "");
  } else {
    bru.setEnvVar("test_stale_interceptorid", "");
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
