meta {
  name: Get OIDC Connection After Update
  type: http
  seq: 8
}
get {
  url: {{env_url}}/api/v1/organizations/{{test_conn_orgid}}/connections/{{test_oidc_connectionid}}
  body: none
  auth: inherit
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("connection is an object", function() { expect(res.body.connection).to.be.an("object"); });
  test("id matches OIDC connection", function() { expect(res.body.connection.id).to.equal(bru.getEnvVar("test_oidc_connectionid")); });
  test("provider is AUTH0", function() { expect(res.body.connection.provider).to.equal("AUTH0"); });
  test("type is OIDC", function() { expect(res.body.connection.type).to.equal("OIDC"); });
  test("status is COMPLETED", function() { expect(res.body.connection.status).to.equal("COMPLETED"); });
  test("enabled is a boolean", function() { expect(res.body.connection.enabled).to.be.a("boolean"); });
  test("debug_enabled is a boolean", function() { expect(res.body.connection.debug_enabled).to.be.a("boolean"); });
  test("organization_id matches", function() { expect(res.body.connection.organization_id).to.equal(bru.getEnvVar("test_conn_orgid")); });
  test("configuration_type is DISCOVERY", function() { expect(res.body.connection.configuration_type).to.equal("DISCOVERY"); });
  test("test_connection_uri is a URL", function() { expect(res.body.connection.test_connection_uri).to.match(/^https?:\/\//); });
  test("attribute_mapping is an object", function() { expect(res.body.connection.attribute_mapping).to.be.an("object"); });
  test("attribute_mapping email persisted", function() { expect(res.body.connection.attribute_mapping.email).to.equal("email"); });
  test("oidc_config is an object", function() { expect(res.body.connection.oidc_config).to.be.an("object"); });
  test("oidc_config.discovery_endpoint persisted", function() {
    expect(res.body.connection.oidc_config.discovery_endpoint).to.equal(
      "https://oidc.scalekit.dev/.well-known/openid-configuration"
    );
  });
  test("oidc_config.client_id persisted", function() { expect(res.body.connection.oidc_config.client_id).to.equal("dummy_client_id"); });
  test("oidc_config.issuer is populated", function() { expect(res.body.connection.oidc_config.issuer).to.be.a("string").and.not.empty; });
  test("oidc_config.authorize_uri is a URL", function() { expect(res.body.connection.oidc_config.authorize_uri).to.match(/^https?:\/\//); });
  test("oidc_config.token_uri is a URL", function() { expect(res.body.connection.oidc_config.token_uri).to.match(/^https?:\/\//); });
  test("oidc_config.redirect_uri is a URL", function() { expect(res.body.connection.oidc_config.redirect_uri).to.match(/^https?:\/\//); });
  test("oidc_config.pkce_enabled is a boolean", function() { expect(res.body.connection.oidc_config.pkce_enabled).to.be.a("boolean"); });
  test("oidc_config.idp_logout_required is a boolean", function() { expect(res.body.connection.oidc_config.idp_logout_required).to.be.a("boolean"); });
  test("create_time is present", function() { expect(res.body.connection.create_time).to.exist; });
  test("update_time is present", function() { expect(res.body.connection.update_time).to.exist; });
}
