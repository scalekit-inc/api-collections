meta {
  name: Create Org For Directory Tests
  type: http
  seq: 1
}

post {
  url: {{env_url}}/api/v1/organizations
  body: json
  auth: inherit
}

body:json {
  {
    "display_name": "Directory Test Org {{test_dir_ts}}",
    "external_id": "directory-test-{{test_dir_ts}}"
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setEnvVar("test_dir_ts", ts.toString());
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_dir_orgid", res.body.organization.id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("organization created with org_ prefix", function() {
    expect(res.body.organization.id).to.match(/^org_/);
  });
}
