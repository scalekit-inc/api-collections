# Scalekit Bruno Collection — Personal Credentials
#
# Copy this file to .env and fill in your values.
# .env is gitignored — your credentials will never be committed.
#
# How to use:
#   1. cp .env.example .env
#   2. Fill in your values below
#   3. CLI:  ./run.sh local        (run.sh sources .env automatically)
#      GUI:  Open collection in Bruno app → select any environment →
#            credentials are loaded from .env automatically
#
# Where to find these values:
#   Dashboard → Settings → API Credentials
#
# For local development (env_url defaults to http://localhost:8888 from local.bru)
CLIENT_ID=
CLIENT_SECRET=

# Optional: override the env_url from the selected .bru environment file.
# Leave blank to use the URL defined in the selected Bruno environment (local.bru, staging.bru, etc.)
# ENV_URL=
