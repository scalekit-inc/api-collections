meta {
  name: Rotate Secret
  type: http
  seq: 7
}

post {
  url: {{env_url}}/api/v1/secrets/{{test_secretid}}:rotate
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_secretid", res.body.secret.id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("response has secret object", function() {
    expect(res.body.secret).to.be.an("object");
  });
  test("new id has sec_ prefix", function() {
    expect(res.body.secret.id).to.match(/^sec_/);
  });
  test("secret_type is INTERCEPTOR_HMAC", function() {
    expect(res.body.secret.secret_type).to.equal("INTERCEPTOR_HMAC");
  });
  test("tenant_type is INTERCEPTOR", function() {
    expect(res.body.secret.tenant_type).to.equal("INTERCEPTOR");
  });
  test("plaintext_secret is returned after rotation", function() {
    expect(res.body.secret.plaintext_secret).to.be.a("string").and.not.empty;
  });
  test("secret_suffix is non-empty", function() {
    expect(res.body.secret.secret_suffix).to.be.a("string").and.not.empty;
  });
  test("created_at is present", function() {
    expect(res.body.secret.created_at).to.exist;
  });
  test("expires_at is present", function() {
    expect(res.body.secret.expires_at).to.exist;
  });
}
