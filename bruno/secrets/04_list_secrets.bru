meta {
  name: List Secrets
  type: http
  seq: 6
}

get {
  url: {{env_url}}/api/v1/secrets
  body: none
  auth: inherit
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("secret array is present", function() {
    expect(res.body.secret).to.be.an("array");
  });
  test("secret array is non-empty", function() {
    expect(res.body.secret.length).to.be.greaterThan(0);
  });
  test("created secret appears in list", function() {
    const ids = res.body.secret.map(function(s) { return s.id; });
    expect(ids).to.include(bru.getEnvVar("test_secretid"));
  });
  test("each secret has an id with sec_ prefix", function() {
    res.body.secret.forEach(function(s) {
      expect(s.id).to.match(/^sec_/);
    });
  });
  test("each secret has a secret_type", function() {
    res.body.secret.forEach(function(s) {
      expect(s.secret_type).to.be.a("string").and.not.empty;
    });
  });
  test("each secret has a tenant_type", function() {
    res.body.secret.forEach(function(s) {
      expect(s.tenant_type).to.be.a("string").and.not.empty;
    });
  });
  test("each secret has a secret_suffix", function() {
    res.body.secret.forEach(function(s) {
      expect(s.secret_suffix).to.be.a("string").and.not.empty;
    });
  });
  test("each secret has created_at", function() {
    res.body.secret.forEach(function(s) {
      expect(s.created_at).to.exist;
    });
  });
}
