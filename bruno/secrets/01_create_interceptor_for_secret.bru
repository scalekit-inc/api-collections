meta {
  name: Create Interceptor For Secret Test
  type: http
  seq: 3
}

post {
  url: {{env_url}}/api/v1/interceptors
  body: json
  auth: inherit
}

body:json {
  {
    "display_name": "Secret Test Interceptor {{test_secret_ts}}",
    "description": "Temporary interceptor for secret testing",
    "trigger_point": "PRE_M2M_TOKEN_CREATION",
    "interceptor_type": "AUTH",
    "api_url": "https://example.com/webhook"
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setEnvVar("test_secret_ts", ts.toString());
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_secret_interceptorid", res.body.interceptor.id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("interceptor id has icp_ prefix", function() {
    expect(res.body.interceptor.id).to.match(/^icp_/);
  });
}
