meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{env_url}}/api/v1/organizations/{{test_users_orgid}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "email": "jane.smith.{{test_user_ts}}@acmecorp.io",
    "external_id": "ext-usr-{{test_user_ts}}",
    "send_invitation_email": false,
    "user_profile": {
      "given_name": "Jane",
      "family_name": "Smith",
      "name": "Jane Smith",
      "locale": "en-US",
      "phone_number": "+14155550101",
      "preferred_username": "janesmith",
      "custom_attributes": {
        "department": "engineering",
        "clearance": "level1"
      }
    },
    "membership": {
      "metadata": {
        "invited_by": "admin"
      }
    },
    "metadata": {
      "source": "api-test",
      "env_tier": "staging"
    }
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setEnvVar("test_user_ts", ts.toString());
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_userid", res.body.user.id);
    bru.setEnvVar("test_user_email", res.body.user.email);
    bru.setEnvVar("test_user_external_id", res.body.user.external_id);
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("response has user object", function() {
    expect(res.body.user).to.be.an("object");
  });
  test("id has usr_ prefix", function() {
    expect(res.body.user.id).to.match(/^usr_/);
  });
  test("email matches sent value", function() {
    const ts = bru.getEnvVar("test_user_ts");
    expect(res.body.user.email).to.equal("jane.smith." + ts + "@acmecorp.io");
  });
  test("external_id matches sent value", function() {
    const ts = bru.getEnvVar("test_user_ts");
    expect(res.body.user.external_id).to.equal("ext-usr-" + ts);
  });
  test("user_profile is an object", function() {
    expect(res.body.user.user_profile).to.be.an("object");
  });
  test("user_profile.given_name matches sent value", function() {
    expect(res.body.user.user_profile.given_name).to.equal("Jane");
  });
  test("user_profile.family_name matches sent value", function() {
    expect(res.body.user.user_profile.family_name).to.equal("Smith");
  });
  test("user_profile.locale matches sent value", function() {
    expect(res.body.user.user_profile.locale).to.equal("en-US");
  });
  test("memberships array contains the org", function() {
    expect(res.body.user.memberships).to.be.an("array").with.length.at.least(1);
    expect(res.body.user.memberships[0].organization_id).to.equal(bru.getEnvVar("test_users_orgid"));
  });
  test("membership_status is set", function() {
    expect(res.body.user.memberships[0].membership_status).to.be.a("string").and.not.empty;
  });
  test("create_time is present", function() {
    expect(res.body.user.create_time).to.exist;
  });
  test("update_time is present", function() {
    expect(res.body.user.update_time).to.exist;
  });
  test("environment_id is present", function() {
    expect(res.body.user.environment_id).to.match(/^env_/);
  });
}
