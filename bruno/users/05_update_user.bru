meta {
  name: Update User
  type: http
  seq: 5
}

patch {
  url: {{env_url}}/api/v1/users/{{test_userid}}
  body: json
  auth: inherit
}

body:json {
  {
    "external_id": "ext-usr-updated-{{test_user_ts}}",
    "user_profile": {
      "given_name": "Jane",
      "family_name": "Smith-Updated",
      "name": "Jane Smith-Updated",
      "locale": "fr-FR",
      "phone_number": "+14155550202",
      "preferred_username": "janesmith-updated",
      "custom_attributes": {
        "department": "product",
        "clearance": "level2"
      }
    },
    "metadata": {
      "department": "engineering",
      "job_title": "Senior Engineer"
    }
  }
}

script:pre-request {
  bru.setEnvVar("test_user_updated_external_id", "ext-usr-updated-" + bru.getEnvVar("test_user_ts"));
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("response has user object", function() {
    expect(res.body.user).to.be.an("object");
  });
  test("id is unchanged after update", function() {
    expect(res.body.user.id).to.equal(bru.getEnvVar("test_userid"));
  });
  test("email is unchanged after update", function() {
    expect(res.body.user.email).to.equal(bru.getEnvVar("test_user_email"));
  });
  test("external_id reflects the update", function() {
    expect(res.body.user.external_id).to.equal(bru.getEnvVar("test_user_updated_external_id"));
  });
  test("user_profile is an object", function() {
    expect(res.body.user.user_profile).to.be.an("object");
  });
  test("user_profile.family_name reflects the update", function() {
    expect(res.body.user.user_profile.family_name).to.equal("Smith-Updated");
  });
  test("user_profile.locale reflects the update", function() {
    expect(res.body.user.user_profile.locale).to.equal("fr-FR");
  });
  test("metadata is an object", function() {
    expect(res.body.user.metadata).to.be.an("object");
  });
  test("metadata.department reflects the update", function() {
    expect(res.body.user.metadata.department).to.equal("engineering");
  });
  test("memberships is an array", function() {
    expect(res.body.user.memberships).to.be.an("array");
  });
  test("environment_id has env_ prefix", function() {
    expect(res.body.user.environment_id).to.match(/^env_/);
  });
  test("create_time is unchanged", function() {
    expect(res.body.user.create_time).to.exist;
  });
  test("update_time is present", function() {
    expect(res.body.user.update_time).to.exist;
  });
}
