meta {
  name: Create User to Delete by External ID
  type: http
  seq: 24
}

post {
  url: {{env_url}}/api/v1/organizations/{{test_users_orgid}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "email": "throwaway.{{test_throwaway_ts}}@acmecorp.io",
    "external_id": "throwaway-ext-{{test_throwaway_ts}}",
    "send_invitation_email": false
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setEnvVar("test_throwaway_ts", ts.toString());
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_throwaway_ext_id", res.body.user.external_id);
  }
}

tests {
  test("status is 200 or 201", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  test("response has user object", function() {
    expect(res.body.user).to.be.an("object");
  });
  test("id has usr_ prefix", function() {
    expect(res.body.user.id).to.match(/^usr_/);
  });
  test("external_id has throwaway- prefix", function() {
    expect(res.body.user.external_id).to.match(/^throwaway-ext-/);
  });
}
