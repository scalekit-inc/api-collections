meta {
  name: Update Client
  type: http
  seq: 5
}
patch {
  url: {{env_url}}/api/v1/clients/{{test_clientid}}
  body: json
  auth: inherit
}
body:json {
  {
    "post_login_uris": ["https://app.acmecorp.com/callback", "https://staging.acmecorp.com/callback"],
    "post_logout_redirect_uris": ["https://app.acmecorp.com/logged-out"],
    "initiate_login_uri": "https://app.acmecorp.com/login",
    "name": "Acme Web App Updated"
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("id is unchanged", function() { expect(res.body.client.id).to.equal(bru.getEnvVar("test_clientid")); });
  test("post_login_uris updated to 2 entries", function() {
    expect(res.body.client.post_login_uris).to.be.an("array").with.length(2);
  });
  test("name updated", function() { expect(res.body.client.name).to.equal("Acme Web App Updated"); });
  test("back_channel_logout_uris is an array", function() { expect(res.body.client.back_channel_logout_uris).to.be.an("array"); });
  test("update_time is present", function() { expect(res.body.client.update_time).to.exist; });
}
