meta {
  name: Create Client Secret
  type: http
  seq: 6
}
post {
  url: {{env_url}}/api/v1/clients/{{test_clientid}}/secrets
  body: json
  auth: inherit
}
body:json {
  {}
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_client_secretid", res.body.secret.id);
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("secret has sks_ prefix", function() { expect(res.body.secret.id).to.match(/^sks_/); });
  test("plain_secret is returned on creation", function() { expect(res.body.plain_secret).to.be.a("string").and.not.empty; });
  test("secret_suffix is non-empty", function() { expect(res.body.secret.secret_suffix).to.be.a("string").and.not.empty; });
  test("status is ACTIVE", function() { expect(res.body.secret.status).to.equal("ACTIVE"); });
  test("secret create_time is present", function() { expect(res.body.secret.create_time).to.exist; });
  test("secret update_time is present", function() { expect(res.body.secret.update_time).to.exist; });
}
