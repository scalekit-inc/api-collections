meta {
  name: Get Client
  type: http
  seq: 4
}
get {
  url: {{env_url}}/api/v1/clients/{{test_clientid}}
  body: none
  auth: inherit
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("id matches", function() { expect(res.body.client.id).to.equal(bru.getEnvVar("test_clientid")); });
  test("client_type is WEB_APP", function() { expect(res.body.client.client_type).to.equal("WEB_APP"); });
  test("name is non-empty", function() { expect(res.body.client.name).to.be.a("string").and.not.empty; });
  test("post_login_uris is an array", function() { expect(res.body.client.post_login_uris).to.be.an("array"); });
  test("post_logout_redirect_uris is an array", function() { expect(res.body.client.post_logout_redirect_uris).to.be.an("array"); });
  test("back_channel_logout_uris is an array", function() { expect(res.body.client.back_channel_logout_uris).to.be.an("array"); });
  test("secrets is an array", function() { expect(res.body.client.secrets).to.be.an("array"); });
  test("scopes is an array", function() { expect(res.body.client.scopes).to.be.an("array"); });
  test("create_time is present", function() { expect(res.body.client.create_time).to.exist; });
  test("update_time is present", function() { expect(res.body.client.update_time).to.exist; });
}
