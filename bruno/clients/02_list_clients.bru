meta {
  name: List Clients
  type: http
  seq: 2
}
get {
  url: {{env_url}}/api/v1/clients
  body: none
  auth: inherit
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("clients is an array", function() { expect(res.body.clients).to.be.an("array"); });
  test("total_size is a non-negative number", function() { expect(res.body.total_size).to.be.a("number").and.at.least(0); });
  test("next_page_token is a string", function() { expect(res.body.next_page_token).to.be.a("string"); });
}
