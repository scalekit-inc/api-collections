meta {
  name: Create Client
  type: http
  seq: 3
}
post {
  url: {{env_url}}/api/v1/clients
  body: json
  auth: inherit
}
body:json {
  {
    "name": "Acme Web App {{test_clients_ts}}",
    "client_type": "WEB_APP",
    "description": "Acme Corp dashboard web application",
    "post_login_uris": ["https://app.acmecorp.com/callback"],
    "post_logout_redirect_uris": ["https://app.acmecorp.com/logout"],
    "initiate_login_uri": "https://app.acmecorp.com/login",
    "access_token_expiry": 3600
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_clientid", res.body.client.id);
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("client has id with webc_ prefix", function() { expect(res.body.client.id).to.match(/^webc_/); });
  test("client_type matches", function() { expect(res.body.client.client_type).to.equal("WEB_APP"); });
  test("name matches", function() {
    expect(res.body.client.name).to.include("Acme Web App");
  });
  test("post_login_uris is an array", function() { expect(res.body.client.post_login_uris).to.be.an("array"); });
  test("post_logout_redirect_uris is an array", function() { expect(res.body.client.post_logout_redirect_uris).to.be.an("array"); });
  test("back_channel_logout_uris is an array", function() { expect(res.body.client.back_channel_logout_uris).to.be.an("array"); });
  test("initiate_login_uri matches", function() { expect(res.body.client.initiate_login_uri).to.equal("https://app.acmecorp.com/login"); });
  test("scopes is an array", function() { expect(res.body.client.scopes).to.be.an("array"); });
  test("custom_claims is an array", function() { expect(res.body.client.custom_claims).to.be.an("array"); });
  test("secrets is an array", function() { expect(res.body.client.secrets).to.be.an("array"); });
  test("create_time is present", function() { expect(res.body.client.create_time).to.exist; });
  test("update_time is present", function() { expect(res.body.client.update_time).to.exist; });
}
