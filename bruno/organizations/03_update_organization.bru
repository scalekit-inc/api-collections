meta {
  name: Update Organization
  type: http
  seq: 3
}

patch {
  url: {{env_url}}/api/v1/organizations/{{test_orgid}}
  body: json
  auth: inherit
}

body:json {
  {
    "display_name": "{{test_org_updated_name}}",
    "external_id": "{{test_org_external_id}}",
    "metadata": {
      "plan": "enterprise-plus",
      "industry": "technology",
      "region": "north-america",
      "tier": "gold"
    },
    "logo_url": "https://logo.debounce.com/google.com"
  }
}

script:pre-request {
  const ts = bru.getEnvVar("test_ts");
  bru.setEnvVar("test_org_updated_name", "Acme Corporation Updated " + ts);
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("response has organization object", function() {
    expect(res.body.organization).to.be.an("object");
  });
  test("id is unchanged after update", function() {
    expect(res.body.organization.id).to.equal(bru.getEnvVar("test_orgid"));
  });
  test("external_id is unchanged after update", function() {
    expect(res.body.organization.external_id).to.equal(bru.getEnvVar("test_org_external_id"));
  });
  test("display_name reflects the update", function() {
    expect(res.body.organization.display_name).to.equal(bru.getEnvVar("test_org_updated_name"));
  });
  test("metadata reflects all updated values", function() {
    const meta = res.body.organization.metadata;
    expect(meta).to.be.an("object");
    expect(meta.plan).to.equal("enterprise-plus");
    expect(meta.industry).to.equal("technology");
    expect(meta.region).to.equal("north-america");
    expect(meta.tier).to.equal("gold");
  });
  test("region_code is a non-empty string", function() {
    expect(res.body.organization.region_code).to.be.a("string").and.not.empty;
  });
  test("settings is present with features array", function() {
    expect(res.body.organization.settings).to.be.an("object");
    expect(res.body.organization.settings.features).to.be.an("array");
  });
  test("logo_url reflects the updated value", function() {
    expect(res.body.organization.logo_url).to.equal("https://logo.debounce.com/google.com");
  });
  test("create_time is unchanged", function() {
    expect(res.body.organization.create_time).to.exist;
  });
  test("update_time is present", function() {
    expect(res.body.organization.update_time).to.exist;
  });
}
