meta {
  name: Update Organization Settings
  type: http
  seq: 8
}

patch {
  url: {{env_url}}/api/v1/organizations/{{test_orgid}}/settings
  body: json
  auth: inherit
}

body:json {
  {
    "features": [
      { "name": "sso", "enabled": true }
    ]
  }
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("response has organization object", function() { expect(res.body.organization).to.be.an("object"); });
  test("id is unchanged", function() { expect(res.body.organization.id).to.equal(bru.getEnvVar("test_orgid")); });
  test("settings is an object", function() { expect(res.body.organization.settings).to.be.an("object"); });
  test("settings.features is an array", function() { expect(res.body.organization.settings.features).to.be.an("array"); });
  test("sso feature is enabled", function() {
    const sso = res.body.organization.settings.features.find(function(f) { return f.name === "sso"; });
    expect(sso).to.exist;
    expect(sso.enabled).to.equal(true);
  });
  test("display_name is a non-empty string", function() { expect(res.body.organization.display_name).to.be.a("string").and.not.empty; });
  test("region_code is a non-empty string", function() { expect(res.body.organization.region_code).to.be.a("string").and.not.empty; });
  test("create_time is present", function() { expect(res.body.organization.create_time).to.exist; });
  test("update_time is present", function() { expect(res.body.organization.update_time).to.exist; });
}
