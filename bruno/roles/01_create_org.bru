meta {
  name: Create Org For Roles Tests
  type: http
  seq: 1
}
post {
  url: {{env_url}}/api/v1/organizations
  body: json
  auth: inherit
}
body:json {
  {
    "display_name": "Roles Test Org {{test_roles_ts}}",
    "external_id": "roles-test-{{test_roles_ts}}"
  }
}
script:pre-request {
  const ts = Date.now();
  bru.setEnvVar("test_roles_ts", ts.toString());
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_roles_orgid", res.body.organization.id);
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("org id has org_ prefix", function() { expect(res.body.organization.id).to.match(/^org_/); });
}
