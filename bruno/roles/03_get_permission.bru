meta {
  name: Get Permission
  type: http
  seq: 3
}
get {
  url: {{env_url}}/api/v1/permissions/{{test_permname}}
  body: none
  auth: inherit
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("permission id has perm_ prefix", function() { expect(res.body.permission.id).to.match(/^perm_/); });
  test("permission name matches", function() { expect(res.body.permission.name).to.equal(bru.getEnvVar("test_permname")); });
  test("description is non-empty", function() { expect(res.body.permission.description).to.be.a("string").and.not.empty; });
  test("is_scalekit_permission is false", function() { expect(res.body.permission.is_scalekit_permission).to.equal(false); });
  test("create_time is present", function() { expect(res.body.permission.create_time).to.exist; });
  test("update_time is present", function() { expect(res.body.permission.update_time).to.exist; });
}
