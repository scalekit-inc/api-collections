meta {
  name: Create Organization Role
  type: http
  seq: 9
}
post {
  url: {{env_url}}/api/v1/organizations/{{test_roles_orgid}}/roles
  body: json
  auth: inherit
}
body:json {
  {
    "name": "org_admin_{{test_roles_ts}}",
    "display_name": "Organization Administrator",
    "description": "Full admin access for the organization",
    "permissions": ["{{test_permname}}"]
  }
}
script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_org_rolename", res.body.role.name);
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("role has role_ prefix", function() { expect(res.body.role.id).to.match(/^role_/); });
  test("name matches sent value", function() {
    const ts = bru.getEnvVar("test_roles_ts");
    expect(res.body.role.name).to.equal("org_admin_" + ts);
  });
  test("display_name matches", function() { expect(res.body.role.display_name).to.equal("Organization Administrator"); });
  test("description matches", function() { expect(res.body.role.description).to.equal("Full admin access for the organization"); });
  test("is_org_role is true", function() { expect(res.body.role.is_org_role).to.equal(true); });
  test("permissions array includes the created permission", function() {
    const names = res.body.role.permissions.map(function(p) { return p.name; });
    expect(names).to.include(bru.getEnvVar("test_permname"));
  });
  test("default_creator is a boolean", function() { expect(res.body.role.default_creator).to.be.a("boolean"); });
  test("default_member is a boolean", function() { expect(res.body.role.default_member).to.be.a("boolean"); });
}
