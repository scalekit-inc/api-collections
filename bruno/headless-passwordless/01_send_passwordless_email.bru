meta {
  name: Send Passwordless Email
  type: http
  seq: 2
}
post {
  url: {{env_url}}/api/v1/passwordless/email/send
  body: json
  auth: inherit
}
body:json {
  {
    "email": "user+sktest@example.com",
    "template": "SIGNIN",
    "magiclink_auth_uri": "https://app.acmecorp.com/auth/callback",
    "state": "d62ivasry29lso",
    "expires_in": 300,
    "template_variables": {
      "app_name": "AcmeCorp"
    }
  }
}
script:pre-request {
  // PREREQUISITE: this collection requires test users to be configured in the environment.
  // Run once per environment before using this collection:
  //   PATCH /api/v1/environments/<env_id>/settings/test-user
  //   {"test_user":{"enabled":true,"emails":["user+sktest@example.com"],"static_confirmation_code":"424242"}}
  // Without this setup, step 03 (verify) will return 400 "verification failed" with no clear explanation.
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setEnvVar("test_auth_request_id", res.body.auth_request_id);
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("auth_request_id is returned", function() { expect(res.body.auth_request_id).to.be.a("string").and.not.empty; });
  test("expires_at is a string", function() { expect(res.body.expires_at).to.be.a("string").and.not.empty; });
  test("expires_in is a number", function() { expect(res.body.expires_in).to.be.a("number").and.greaterThan(0); });
  test("passwordless_type is set", function() { expect(res.body.passwordless_type).to.be.a("string").and.not.empty; });
}
