meta {
  name: Verify Passwordless Email
  type: http
  seq: 4
}
post {
  url: {{env_url}}/api/v1/passwordless/email/verify
  body: json
  auth: inherit
}
body:json {
  {
    "auth_request_id": "{{test_auth_request_id}}",
    "code": "424242"
  }
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("email matches the test user", function() { expect(res.body.email).to.equal("user+sktest@example.com"); });
  test("state matches what was sent", function() { expect(res.body.state).to.equal("d62ivasry29lso"); });
  test("template is SIGNIN", function() { expect(res.body.template).to.equal("SIGNIN"); });
  test("passwordless_type is set", function() { expect(res.body.passwordless_type).to.be.a("string").and.not.empty; });
}
