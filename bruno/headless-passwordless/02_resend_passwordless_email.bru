meta {
  name: Resend Passwordless Email
  type: http
  seq: 3
}
post {
  url: {{env_url}}/api/v1/passwordless/email/resend
  body: json
  auth: inherit
}
body:json {
  {
    "auth_request_id": "{{test_auth_request_id}}"
  }
}
script:post-response {
  if (res.status === 200 && res.body.auth_request_id) {
    bru.setEnvVar("test_auth_request_id", res.body.auth_request_id);
  }
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("auth_request_id is returned", function() { expect(res.body.auth_request_id).to.be.a("string").and.not.empty; });
  test("expires_at is a string", function() { expect(res.body.expires_at).to.be.a("string").and.not.empty; });
  test("expires_in is a number", function() { expect(res.body.expires_in).to.be.a("number").and.greaterThan(0); });
  test("passwordless_type matches", function() { expect(res.body.passwordless_type).to.be.a("string").and.not.empty; });
}
