meta {
  name: List Email Servers
  type: http
  seq: 2
}
get {
  url: {{env_url}}/api/v1/email/servers
  body: none
  auth: inherit
}
tests {
  test("status is 200 or 500 (feature may not be enabled locally)", function() {
    expect(res.status).to.be.oneOf([200, 500]);
  });
  test("servers is an array when available", function() {
    if (res.status === 200) {
      expect(res.body.servers).to.be.an("array");
    }
  });
}
