meta {
  name: Get Email Template
  type: http
  seq: 4
}
get {
  url: {{env_url}}/api/v1/organizations/{{test_emails_orgid}}/email/templates/{{test_templateid}}
  body: none
  auth: inherit
}
tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("template is an object", function() { expect(res.body.template).to.be.an("object"); });
  test("id matches", function() { expect(res.body.template.id).to.equal(bru.getEnvVar("test_templateid")); });
  test("use_case is LOGIN", function() { expect(res.body.template.use_case).to.equal("LOGIN"); });
  test("subject matches", function() { expect(res.body.template.subject).to.equal("Sign in to Acme Corp"); });
  test("html_content is non-empty", function() { expect(res.body.template.html_content).to.be.a("string").and.not.empty; });
  test("plain_content is non-empty", function() { expect(res.body.template.plain_content).to.be.a("string").and.not.empty; });
  test("placeholders is an array", function() { expect(res.body.template.placeholders).to.be.an("array"); });
  test("enabled is a boolean", function() { expect(res.body.template.enabled).to.be.a("boolean"); });
  test("updated_at is present", function() { expect(res.body.template.updated_at).to.exist; });
}
